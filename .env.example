# Contact Form Email Configuration
# This is an EXAMPLE file. Create a .env.local file with your actual credentials.
# Only Resend is required (email delivery via Resend API)

# Resend API Key (for sending emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email (where contact form submissions arrive)
CONTACT_TO=hello@sriharshagade.com

# Setup Instructions:
# 1. Get your Resend API key from: https://resend.com/api-keys
# 2. Create .env.local in the project root
# 3. Add RESEND_API_KEY and CONTACT_TO with your actual values
# 4. Never commit .env.local to git (it's already in .gitignore)

sarvam_api = sk_your_sarvam_api_key_here
