# Contact Form Email Configuration
# This is an EXAMPLE file. Create a .env.local file with your actual credentials.

# Gmail SMTP (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=krishnasriharshagade@gmail.com
SMTP_PASS=your_google_app_password

# Recipient (where emails arrive)
CONTACT_TO=hello@sriharshagade.com
resend.api_key = your_resend_api_key
# Setup Instructions:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer" (or your device)
# 3. Google will generate a 16-character app password
# 4. Copy that password to SMTP_PASS above
# 5. Create .env.local in the project root with these values
# 6. Never commit .env.local to git
